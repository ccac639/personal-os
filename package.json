{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "description": "Personal OS — 个人工作台 + AI Agent + Workflow + 项目管理 + 成果管理 + 博客 一体化个人操作系统",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,vue,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean && rimraf -g \"**/node_modules\" \"**/dist\" \"**/.output\" \"**/.nuxt\" \"**/.turbo\" \"**/coverage\"",
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@personal-os/config": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "*.{ts,vue,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
