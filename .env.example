# ---- 基础 ----
# development | test | production（production 下默认关闭 Swagger）
NODE_ENV=development

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- API 监听（部署模式） ----
# 默认仅监听本机 127.0.0.1（个人使用，默认不对外暴露）。
# 部署模式（显式开启，见下方"API Key 鉴权"）：
#   本机：API_HOST=127.0.0.1（默认，无需 API Key 也可在 development 使用）
#   局域网：API_HOST=0.0.0.0 + 配置 PERSONAL_OS_API_KEY
#   公网：建议经反向代理（nginx/caddy）转发 + 配置 PERSONAL_OS_API_KEY + TRUST_PROXY
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
BLOG_PORT=3001

# ---- 数据库（必填，非法值启动即报错） ----
MONGODB_URI=mongodb://localhost:27017/personal_os

# ---- Redis（必填） ----
REDIS_URL=redis://localhost:6379

# ---- Worker（apps/worker，后台异步任务） ----
# Chat 适配器：siliconflow（默认，Key 在 Web 设置页输入后从 Redis 读取）| deterministic-mock（离线/测试）
# CHAT_ADAPTER=deterministic-mock
# 任一 worker 初始化失败时的策略：all（默认，整体退出由进程管理器重启）| partial（继续运行健康 worker）
# WORKER_FAILURE_POLICY=all
# workflow-runs / chat-generation worker 并发数（默认 4 / 2）
# WORKER_CONCURRENCY=4
# CHAT_CONCURRENCY=2
# 优雅关闭等待在途任务上限 ms（默认 30000，超时强制关闭）
# WORKER_SHUTDOWN_GRACE_MS=30000
# worker 就绪等待上限 ms（默认 20000）
# WORKER_INIT_TIMEOUT_MS=20000
# Redis / Mongo 连接超时 ms（默认 10000 / 5000）
# WORKER_REDIS_CONNECT_TIMEOUT_MS=10000
# WORKER_MONGO_CONNECT_TIMEOUT_MS=5000

# ---- 可选：API Key 鉴权（机器级访问保护） ----
# 配置后（≥8 位），除 /api/health、Swagger 文档、OPTIONS 外，所有 API 必须携带
# X-API-Key 请求头（timing-safe 比较）。个人单用户系统，无登录/用户体系。
#   development / test：不配置即显式关闭鉴权（默认纯本机使用）
#   production：必须配置，缺失则拒绝启动（fail-fast）
# PERSONAL_OS_API_KEY=

# ---- CORS（必填：允许的 Web Origin，精确匹配，不支持 *） ----
CORS_ORIGIN=http://localhost:5173

# ---- 可信代理（可选，默认关闭） ----
# 是否信任反向代理的 X-Forwarded-* 头（影响限流指纹与访问日志中的客户端 IP）。
#   true / false：全局信任 / 不信任
#   或逗号分隔的 IP/CIDR 列表：仅信任这些上游（如 127.0.0.1, 10.0.0.0/8）
# 仅本机直连时保持默认关闭；局域网/公网经反向代理部署时必须按实际代理地址开启。
# TRUST_PROXY=false

# ---- 请求保护（可选，默认值见下） ----
# 单请求处理超时 ms（默认 30000，超时返回 408 REQUEST_TIMEOUT）
# REQUEST_TIMEOUT_MS=30000
# 请求体体积上限 bytes（默认 1MB，超限返回 413 PAYLOAD_TOO_LARGE）
# REQUEST_BODY_LIMIT_BYTES=1048576
# 内存限流：单 IP(+API Key) 在窗口内最大请求数 / 窗口 ms（默认 300 次 / 60s，超限 429）
# RATE_LIMIT_MAX_REQUESTS=300
# RATE_LIMIT_WINDOW_MS=60000

# ---- 健康检查（可选） ----
# /api/ready 就绪检查中每项依赖检查的超时 ms（默认 2000，超时视为 down）
# HEALTH_CHECK_TIMEOUT_MS=2000

# ---- Swagger（可选） ----
# 默认：development/test 开启，production 关闭；可显式覆盖
# SWAGGER_ENABLED=true

# ---- Auth（预留） ----
JWT_SECRET=dev-only-secret-change-me

# ---- AI Providers（未配置，按需填写） ----
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ---- S3 兼容存储（MinIO） ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=personal-os

# ---- 服务地址 ----
WEB_URL=http://localhost:5173
BLOG_URL=http://localhost:3001
API_URL=http://localhost:3000

# ---- 前端构建时注入（Vite） ----
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
