# ---- 基础 ----
# development | test | production（production 下默认关闭 Swagger）
NODE_ENV=development

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- API 监听 ----
# 个人使用默认仅监听本机 127.0.0.1；如需局域网访问改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
BLOG_PORT=3001

# ---- 数据库（必填，非法值启动即报错） ----
MONGODB_URI=mongodb://localhost:27017/personal_os

# ---- Redis（必填） ----
REDIS_URL=redis://localhost:6379

# ---- 可选：API Key 鉴权 ----
# 配置后（≥8 位），除 /health、Swagger 文档、OPTIONS 外，所有 API 必须携带 X-API-Key
# 不配置则纯本机使用、不鉴权
# PERSONAL_OS_API_KEY=

# ---- CORS（必填：允许的 Web Origin，精确匹配，不支持 *） ----
CORS_ORIGIN=http://localhost:5173

# ---- Swagger（可选） ----
# 默认：development/test 开启，production 关闭；可显式覆盖
# SWAGGER_ENABLED=true

# ---- Auth（预留） ----
JWT_SECRET=dev-only-secret-change-me

# ---- AI Providers（未配置，按需填写） ----
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ---- S3 兼容存储（MinIO） ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=personal-os

# ---- 服务地址 ----
WEB_URL=http://localhost:5173
BLOG_URL=http://localhost:3001
API_URL=http://localhost:3000

# ---- 前端构建时注入（Vite） ----
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
